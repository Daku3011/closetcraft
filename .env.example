# Copy to .env and fill in. The real .env is never committed to git.
# Leave everything commented out for plain local mode (SQLite file + uploads/ folder).

# Supabase Postgres (accounts, clothes, fits survive restarts)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres?sslmode=require

# Supabase Storage (uploaded photos survive restarts)
# SUPABASE_URL=https://XXXX.supabase.co
# SUPABASE_KEY=your-service-role-key-here
# SUPABASE_BUCKET=closet-images
